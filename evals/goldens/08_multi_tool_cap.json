{
  "id": "multi-tool-under-cap-passes",
  "desc": "(h) up to WEBGPT_MAX_TOOL_CALLS_PER_TURN (default 3) tool calls pass without correction; overflow fires MULTI_TOOL",
  "module": "gateway",
  "input": {
    "env": {"WEBGPT_TOOL_PROTOCOL": "soft"},
    "tool_choice": "auto",
    "tail": [],
    "messages": [
      {"role": "user", "content": "Set up the workspace: inspect it, then write notes."}
    ],
    "under_cap_text": "<cmd>pwd</cmd>\n<cmd>ls -la</cmd>\n<cmd>cat README.md</cmd>",
    "over_cap_text": "<cmd>pwd</cmd>\n<cmd>ls -la</cmd>\n<cmd>cat README.md</cmd>\n<cmd>whoami</cmd>",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "Bash",
          "description": "Executes a shell command inside the client workspace",
          "parameters": {
            "type": "object",
            "properties": {"command": {"type": "string"}},
            "required": ["command"]
          }
        }
      }
    ]
  },
  "expect": {
    "under_cap_issue": null,
    "over_cap_reason": "MULTI_TOOL"
  }
}
